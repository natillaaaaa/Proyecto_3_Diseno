<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>About Us — Hikari's Records</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #fafafa; color: #1a1a1a; }

    /* ===== TOP BAR ===== */
    .top-bar {
      background: #1a1a1a; color: #ccc; font-size: 12px;
      padding: 6px 0; letter-spacing: 0.5px;
    }
    .top-bar a { color: #ccc; text-decoration: none; }
    .top-bar a:hover { color: #fff; }

    /* ===== NAVBAR ===== */
    .navbar-main {
      background: #fff; border-bottom: 1px solid #e8e8e8;
      padding: 0; position: sticky; top: 0; z-index: 1000;
      box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }
    .navbar-inner {
      display: flex; align-items: center; gap: 2rem; padding: 0.75rem 2rem;
    }
    .brand {
      font-family: 'Playfair Display', serif; font-size: 1.6rem;
      font-weight: 700; color: #1a1a1a; text-decoration: none; white-space: nowrap;
    }
    .brand span { color: #c9a96e; }
    .search-bar { flex: 1; max-width: 420px; position: relative; }
    .search-bar input {
      width: 100%; border: 1.5px solid #e0e0e0; border-radius: 50px;
      padding: 8px 44px 8px 18px; font-size: 14px; outline: none;
      transition: border 0.2s; font-family: 'Inter', sans-serif;
    }
    .search-bar input:focus { border-color: #c9a96e; }
    .search-bar button {
      position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
      background: none; border: none; color: #888; cursor: pointer; font-size: 16px;
    }
    .nav-links { display: flex; align-items: center; gap: 0.25rem; list-style: none; margin: 0; }
    .nav-links a {
      color: #333; text-decoration: none; font-size: 14px; font-weight: 500;
      padding: 8px 14px; border-radius: 8px; transition: 0.2s;
    }
    .nav-links a:hover, .nav-links a.active { background: #f5f0e8; color: #c9a96e; }
    .nav-icon-btn {
      background: none; border: none; font-size: 20px; color: #555;
      cursor: pointer; padding: 6px 8px; border-radius: 8px; transition: 0.2s;
    }
    .nav-icon-btn:hover { background: #f5f0e8; color: #c9a96e; }

    /* ===== BREADCRUMB ===== */
    .breadcrumb-bar {
      background: #f5f0e8; padding: 10px 2rem;
      border-bottom: 1px solid #e8dfc8;
    }
    .breadcrumb { margin: 0; font-size: 13px; }
    .breadcrumb-item a { color: #c9a96e; text-decoration: none; }
    .breadcrumb-item.active { color: #666; }

    /* ===== LAYOUT ===== */
    .page-layout {
      display: flex; max-width: 1400px; margin: 0 auto;
      padding: 2rem 1.5rem; gap: 2rem;
    }

    /* ===== SIDEBAR ===== */
    .sidebar { width: 240px; flex-shrink: 0; }
    .sidebar-card {
      background: #fff; border-radius: 16px; border: 1px solid #eeeeee;
      padding: 1.25rem; margin-bottom: 1.25rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }
    .sidebar-title {
      font-family: 'Playfair Display', serif; font-size: 15px; font-weight: 600;
      color: #1a1a1a; margin-bottom: 1rem; padding-bottom: 0.5rem;
      border-bottom: 2px solid #f5f0e8;
    }
    .sidebar-link {
      display: flex; align-items: center; gap: 10px; padding: 9px 10px;
      border-radius: 10px; color: #444; text-decoration: none;
      font-size: 14px; font-weight: 400; transition: 0.2s; margin-bottom: 2px;
    }
    .sidebar-link:hover, .sidebar-link.active { background: #f5f0e8; color: #c9a96e; }
    .sidebar-link i { font-size: 16px; width: 20px; text-align: center; }
    .badge-count {
      margin-left: auto; background: #f5f0e8; color: #c9a96e;
      font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 20px;
    }

    /* ===== MAIN ===== */
    .main-content { flex: 1; min-width: 0; }

    /* ===== HERO ===== */
    .hero-section {
      background:
        linear-gradient(rgba(0,0,0,0.62), rgba(0,0,0,0.62)),
        url('https://i.pinimg.com/1200x/f1/6c/8e/f16c8e6cc11cb26c03b27eb90e5d2c7a.jpg');
      background-size: cover;
      background-position: center;
      border-radius: 20px;
      padding: 80px 56px;
      margin-bottom: 2.5rem;
      position: relative;
      overflow: hidden;
    }
    .hero-section::before {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(201,169,110,0.15) 0%, transparent 60%);
      border-radius: 20px;
    }
    .hero-badge {
      display: inline-block;
      background: rgba(201,169,110,0.2);
      border: 1px solid rgba(201,169,110,0.5);
      color: #e8c98a;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      padding: 5px 14px;
      border-radius: 20px;
      margin-bottom: 1rem;
    }
    .hero-section h1 {
      font-family: 'Playfair Display', serif;
      font-size: 3rem; font-weight: 700;
      color: #fff; margin-bottom: 1rem; line-height: 1.2;
    }
    .hero-section h1 span { color: #c9a96e; }
    .hero-section p {
      color: rgba(255,255,255,0.82);
      font-size: 16px; line-height: 1.8;
      max-width: 600px; padding: 0; margin: 0;
    }

    /* ===== STATS ===== */
    .stats-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin-bottom: 2.5rem;
    }
    .stat-card {
      background: #fff;
      border: 1px solid #eee;
      border-radius: 16px;
      padding: 1.5rem;
      text-align: center;
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
      transition: 0.2s;
    }
    .stat-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.1); }
    .stat-number {
      font-family: 'Playfair Display', serif;
      font-size: 2rem; font-weight: 700; color: #c9a96e;
    }
    .stat-label { font-size: 12px; color: #888; text-transform: uppercase; letter-spacing: 1px; margin-top: 4px; }

    /* ===== SECTION TITLE ===== */
    .section-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.5rem; font-weight: 700; color: #1a1a1a;
      margin-bottom: 0.5rem;
    }
    .section-subtitle { color: #777; font-size: 15px; line-height: 1.7; margin-bottom: 2rem; }

    /* ===== VALUES CARDS ===== */
    .value-card {
      background: #fff;
      border: 1px solid #eee;
      border-radius: 20px;
      padding: 2rem 1.5rem;
      text-align: center;
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
      transition: 0.25s;
      height: 100%;
    }
    .value-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 16px 40px rgba(0,0,0,0.1);
    }
    .value-icon {
      width: 64px; height: 64px;
      border-radius: 50%;
      background: #f5f0e8;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 1.25rem;
      font-size: 28px;
      color: #c9a96e;
    }
    .value-card h3 {
      font-family: 'Playfair Display', serif;
      font-size: 1.2rem; font-weight: 700;
      color: #1a1a1a; margin-bottom: 0.75rem; text-align: center;
    }
    .value-card p {
      color: #666; font-size: 14px; line-height: 1.7;
      padding: 0; margin: 0;
    }

    /* ===== MARQUEE ===== */
    .marquee-section {
      background: #1a1a1a; padding: 16px 0;
      overflow: hidden; margin: 2.5rem 0;
    }
    .marquee-track {
      display: flex; animation: marquee 30s linear infinite; white-space: nowrap;
    }
    .marquee-item {
      display: flex; align-items: center; gap: 12px;
      padding: 0 2rem; color: #c9a96e; font-size: 14px;
      font-weight: 500; letter-spacing: 1px;
    }
    .marquee-dot { color: #555; font-size: 20px; }
    @keyframes marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    /* ===== FOOTER ===== */
    footer { background: #1a1a1a; color: #ccc; padding: 3rem 0 1.5rem; margin-top: 3rem; }
    .footer-brand {
      font-family: 'Playfair Display', serif; font-size: 1.4rem;
      font-weight: 700; color: #fff; margin-bottom: 0.5rem;
    }
    .footer-brand span { color: #c9a96e; }
    footer h6 {
      color: #fff; font-weight: 600; font-size: 13px;
      text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1rem;
    }
    footer p, footer div { color: #999; font-size: 13px; line-height: 1.8; }
    .footer-divider { border-top: 1px solid #333; margin: 2rem 0 1rem; }
    .footer-bottom { font-size: 12px; color: #666; text-align: center; }
    .footer-social a {
      color: #666; font-size: 18px; margin-right: 12px;
      text-decoration: none; transition: 0.2s;
    }
    .footer-social a:hover { color: #c9a96e; }
  </style>
</head>
<body>

<!-- TOP BAR -->
<div class="top-bar">
  <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
    <span><i class="bi bi-telephone me-1"></i> Whatsapp: 8604-1107 &nbsp;|&nbsp; <i class="bi bi-envelope me-1"></i> hikaris@gmail.com</span>
    <span>Universidad Nacional — Diseño de Sitios Web — Proyecto 3</span>
  </div>
</div>

<!-- NAVBAR -->
<nav class="navbar-main">
  <div class="navbar-inner">
    <a href="../index.html" class="brand">Hikari's <span>Records</span></a>
    <div class="search-bar">
      <input type="text" placeholder="Buscar artistas, álbumes, géneros...">
      <button><i class="bi bi-search"></i></button>
    </div>
    <ul class="nav-links d-none d-lg-flex">
      <li><a href="../index.html">Inicio</a></li>
      <li><a href="#">Artistas</a></li>
      <li><a href="#">Álbumes</a></li>
      <li><a href="#">Géneros</a></li>
      <li><a href="#" class="active">Nosotros</a></li>
    </ul>
    <div class="d-flex gap-1 ms-auto ms-lg-0">
      <button class="nav-icon-btn"><i class="bi bi-heart"></i></button>
      <button class="nav-icon-btn"><i class="bi bi-bag"></i></button>
      <button class="nav-icon-btn"><i class="bi bi-person"></i></button>
    </div>
  </div>
</nav>

<!-- BREADCRUMB -->
<div class="breadcrumb-bar">
  <div class="container-fluid px-4">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="../index.html"><i class="bi bi-house me-1"></i>Inicio</a></li>
        <li class="breadcrumb-item active">About Us</li>
      </ol>
    </nav>
  </div>
</div>

<!-- PAGE LAYOUT -->
<div class="page-layout">

  <!-- SIDEBAR -->
  <aside class="sidebar d-none d-xl-block">

    <div class="sidebar-card">
      <div class="sidebar-title"><i class="bi bi-mortarboard me-2"></i>Proyecto</div>
      <div style="font-size:12px; color:#666; line-height:1.7;">
        <strong style="color:#1a1a1a;">Universidad Nacional</strong><br>
        Escuela de Informática<br>
        Diseño de Sitios Web<br>
        <span style="color:#c9a96e; font-weight:600;">Proyecto 3 — InjaX SSG</span>
      </div>
    </div>

    <div class="sidebar-card">
      <div class="sidebar-title">Categorías</div>
      <a href="#" class="sidebar-link"><i class="bi bi-music-note-beamed"></i> Pop <span class="badge-count">24</span></a>
      <a href="#" class="sidebar-link"><i class="bi bi-music-note-list"></i> Rock <span class="badge-count">18</span></a>
      <a href="#" class="sidebar-link"><i class="bi bi-soundwave"></i> Reggaeton <span class="badge-count">31</span></a>
      <a href="#" class="sidebar-link"><i class="bi bi-vinyl"></i> Jazz <span class="badge-count">12</span></a>
      <a href="#" class="sidebar-link"><i class="bi bi-headphones"></i> Electrónica <span class="badge-count">9</span></a>
      <a href="#" class="sidebar-link"><i class="bi bi-star"></i> K-Pop <span class="badge-count">15</span></a>
    </div>

    <div class="sidebar-card">
      <div class="sidebar-title">Accesos rápidos</div>
      <a href="#" class="sidebar-link"><i class="bi bi-people"></i> Artistas</a>
      <a href="#" class="sidebar-link"><i class="bi bi-disc"></i> Álbumes</a>
      <a href="#" class="sidebar-link"><i class="bi bi-cart"></i> Tienda</a>
      <a href="#" class="sidebar-link"><i class="bi bi-search"></i> Búsqueda</a>
    </div>

  </aside>

  <!-- MAIN -->
  <main class="main-content">

    <!-- HERO -->
    <div class="hero-section">
      <div class="hero-badge"><i class="bi bi-music-note me-1"></i> Est. 2020</div>
      <h1>{{ hero.titulo | replace("'", "'") }}<br><span>About Us</span></h1>
      <p>{{ hero.descripcion }}</p>
    </div>

    <!-- STATS -->
    <div class="stats-row">
      {% for s in stats %}
        <div class="stat-card">
          <div class="stat-number">{{ s.numero }}</div>
          <div class="stat-label">{{ s.label }}</div>
        </div>
      {% endfor %}
    </div>

    <!-- WHY MUSIC -->
    <h2 class="section-title">{{ seccion.titulo }}</h2>
    <p class="section-subtitle">{{ seccion.descripcion }}</p>

    <!-- VALUES -->
    <div class="row g-3 mb-4">
      {% for v in valores %}
        <div class="col-md-4">
          <div class="value-card">
            <div class="value-icon">
              <i class="bi {{ v.icono }}"></i>
            </div>
            <h3>{{ v.titulo }}</h3>
            <p>{{ v.descripcion }}</p>
          </div>
        </div>
      {% endfor %}
    </div>

  </main>
</div>

<!-- MARQUEE -->
<div class="marquee-section">
  <div class="marquee-track">
    <span class="marquee-item"><i class="bi bi-music-note"></i> Passion</span><span class="marquee-dot">·</span>
    <span class="marquee-item"><i class="bi bi-shield-check"></i> Trust</span><span class="marquee-dot">·</span>
    <span class="marquee-item"><i class="bi bi-lightning-charge"></i> Innovation</span><span class="marquee-dot">·</span>
    <span class="marquee-item"><i class="bi bi-headphones"></i> Hikari's Records</span><span class="marquee-dot">·</span>
    <span class="marquee-item"><i class="bi bi-music-note"></i> Passion</span><span class="marquee-dot">·</span>
    <span class="marquee-item"><i class="bi bi-shield-check"></i> Trust</span><span class="marquee-dot">·</span>
    <span class="marquee-item"><i class="bi bi-lightning-charge"></i> Innovation</span><span class="marquee-dot">·</span>
    <span class="marquee-item"><i class="bi bi-headphones"></i> Hikari's Records</span><span class="marquee-dot">·</span>
  </div>
</div>

<!-- FOOTER -->
<footer>
  <div class="container">
    <div class="row g-4">
      <div class="col-md-3">
        <div class="footer-brand">Hikari's <span>Records</span></div>
        <p style="font-size:13px; color:#666; margin-top:8px; padding:0;">Tu destino de música y cultura pop.</p>
        <div class="footer-social mt-3">
          <a href="#"><i class="bi bi-facebook"></i></a>
          <a href="#"><i class="bi bi-instagram"></i></a>
          <a href="#"><i class="bi bi-whatsapp"></i></a>
        </div>
      </div>
      <div class="col-md-3">
        <h6>Métodos de pago</h6>
        {% for p in footer.pagos %}<div>{{ p }}</div>{% endfor %}
      </div>
      <div class="col-md-3">
        <h6>Ubicación</h6>
        {% for u in footer.ubicacion %}<div>{{ u }}</div>{% endfor %}
      </div>
      <div class="col-md-3">
        <h6>Contacto</h6>
        {% for c in footer.contacto %}<div>{{ c }}</div>{% endfor %}
      </div>
    </div>
    <div class="footer-divider"></div>
    <div class="footer-bottom">
      © 2026 Hikari's Records — Universidad Nacional, Escuela de Informática, Diseño de Sitios Web, Proyecto 3
    </div>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
