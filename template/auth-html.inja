<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Login — Hikari's Records</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #fafafa; color: #1a1a1a; }

    /* ===== TOP BAR ===== */
    .top-bar { background: #1a1a1a; color: #ccc; font-size: 12px; padding: 6px 0; letter-spacing: 0.5px; }
    .top-bar a { color: #ccc; text-decoration: none; }
    .top-bar a:hover { color: #fff; }

    /* ===== NAVBAR ===== */
    .navbar-main {
      background: #fff; border-bottom: 1px solid #e8e8e8;
      padding: 0; position: sticky; top: 0; z-index: 1000;
      box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }
    .navbar-inner { display: flex; align-items: center; gap: 2rem; padding: 0.75rem 2rem; }
    .brand { font-family: 'Playfair Display', serif; font-size: 1.6rem; font-weight: 700; color: #1a1a1a; text-decoration: none; white-space: nowrap; }
    .brand span { color: #c9a96e; }
    .search-bar { flex: 1; max-width: 420px; position: relative; }
    .search-bar input {
      width: 100%; border: 1.5px solid #e0e0e0; border-radius: 50px;
      padding: 8px 44px 8px 18px; font-size: 14px; outline: none;
      transition: border 0.2s; font-family: 'Inter', sans-serif;
    }
    .search-bar input:focus { border-color: #c9a96e; }
    .search-bar button { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; color: #888; cursor: pointer; font-size: 16px; }
    .nav-links { display: flex; align-items: center; gap: 0.25rem; list-style: none; margin: 0; }
    .nav-links a { color: #333; text-decoration: none; font-size: 14px; font-weight: 500; padding: 8px 14px; border-radius: 8px; transition: 0.2s; }
    .nav-links a:hover, .nav-links a.active { background: #f5f0e8; color: #c9a96e; }
    .nav-icon-btn { background: none; border: none; font-size: 20px; color: #555; cursor: pointer; padding: 6px 8px; border-radius: 8px; transition: 0.2s; }
    .nav-icon-btn:hover { background: #f5f0e8; color: #c9a96e; }

    /* ===== BREADCRUMB ===== */
    .breadcrumb-bar { background: #f5f0e8; padding: 10px 2rem; border-bottom: 1px solid #e8dfc8; }
    .breadcrumb { margin: 0; font-size: 13px; }
    .breadcrumb-item a { color: #c9a96e; text-decoration: none; }
    .breadcrumb-item.active { color: #666; }

    /* ===== LAYOUT ===== */
    .page-layout { display: flex; max-width: 1400px; margin: 0 auto; padding: 2rem 1.5rem; gap: 2rem; }

    /* ===== SIDEBAR ===== */
    .sidebar { width: 240px; flex-shrink: 0; }
    .sidebar-card { background: #fff; border-radius: 16px; border: 1px solid #eeeeee; padding: 1.25rem; margin-bottom: 1.25rem; box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
    .sidebar-title { font-family: 'Playfair Display', serif; font-size: 15px; font-weight: 600; color: #1a1a1a; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid #f5f0e8; }
    .sidebar-link { display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 10px; color: #444; text-decoration: none; font-size: 14px; font-weight: 400; transition: 0.2s; margin-bottom: 2px; }
    .sidebar-link:hover, .sidebar-link.active { background: #f5f0e8; color: #c9a96e; }
    .sidebar-link i { font-size: 16px; width: 20px; text-align: center; }
    .badge-count { margin-left: auto; background: #f5f0e8; color: #c9a96e; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 20px; }

    /* ===== MAIN ===== */
    .main-content { flex: 1; min-width: 0; display: flex; align-items: flex-start; justify-content: center; }

    /* ===== AUTH CARD ===== */
    .auth-card {
      width: 100%; max-width: 480px;
      background: #fff; border-radius: 20px;
      border: 1px solid #eeeeee;
      box-shadow: 0 8px 32px rgba(0,0,0,0.08);
      overflow: hidden;
    }
    .auth-header {
      background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
      padding: 2.5rem 2rem; text-align: center;
      border-bottom: 3px solid #c9a96e;
    }
    .auth-header i { font-size: 2.5rem; color: #c9a96e; }
    .auth-header h2 { font-family: 'Playfair Display', serif; font-size: 1.6rem; font-weight: 700; color: #fff; margin: 0.5rem 0 0.25rem; }
    .auth-header p { font-size: 13px; color: rgba(255,255,255,0.5); margin: 0; }
    .auth-tabs { display: flex; border-bottom: 1px solid #eee; }
    .auth-tab {
      flex: 1; padding: 1rem; text-align: center;
      font-size: 14px; font-weight: 600; cursor: pointer;
      color: #888; background: none; border: none;
      border-bottom: 3px solid transparent; transition: all 0.2s;
      font-family: 'Inter', sans-serif;
    }
    .auth-tab.active { color: #c9a96e; border-bottom: 3px solid #c9a96e; background: #fdfaf5; }
    .auth-tab:hover:not(.active) { background: #f9f9f9; color: #555; }
    .auth-body { padding: 2rem; }
    .auth-panel { display: none; }
    .auth-panel.active { display: block; }
    .form-label { font-size: 13px; font-weight: 600; color: #333; margin-bottom: 6px; }
    .input-group-text { background: #f5f0e8; border-color: #e0e0e0; color: #c9a96e; }
    .form-control { border-color: #e0e0e0; font-size: 14px; font-family: 'Inter', sans-serif; }
    .form-control:focus { box-shadow: none; border-color: #c9a96e; }
    .btn-auth {
      background: linear-gradient(135deg, #c9a96e, #a07840);
      color: #fff; border: none; width: 100%;
      padding: 0.75rem; border-radius: 10px;
      font-size: 15px; font-weight: 600;
      letter-spacing: 0.3px; transition: 0.2s;
      font-family: 'Inter', sans-serif;
    }
    .btn-auth:hover { opacity: 0.9; transform: translateY(-1px); box-shadow: 0 4px 16px rgba(201,169,110,0.3); }

    /* ===== MARQUEE ===== */
    .marquee-section { background: #1a1a1a; padding: 16px 0; overflow: hidden; margin: 2.5rem 0; }
    .marquee-track { display: flex; animation: marquee 30s linear infinite; white-space: nowrap; }
    .marquee-item { display: flex; align-items: center; gap: 12px; padding: 0 2rem; color: #c9a96e; font-size: 14px; font-weight: 500; letter-spacing: 1px; }
    .marquee-dot { color: #555; font-size: 20px; }
    @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

    /* ===== FOOTER ===== */
    footer { background: #1a1a1a; color: #ccc; padding: 3rem 0 1.5rem; margin-top: 3rem; }
    .footer-brand { font-family: 'Playfair Display', serif; font-size: 1.4rem; font-weight: 700; color: #fff; margin-bottom: 0.5rem; }
    .footer-brand span { color: #c9a96e; }
    footer h6 { color: #fff; font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1rem; }
    footer p, footer div { color: #999; font-size: 13px; line-height: 1.8; }
    .footer-divider { border-top: 1px solid #333; margin: 2rem 0 1rem; }
    .footer-bottom { font-size: 12px; color: #666; text-align: center; }
    .footer-social a { color: #666; font-size: 18px; margin-right: 12px; text-decoration: none; transition: 0.2s; }
    .footer-social a:hover { color: #c9a96e; }
  </style>
</head>
<body>

<!-- TOP BAR -->
<div class="top-bar">
  <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
    <span><i class="bi bi-telephone me-1"></i> Whatsapp: 8604-1107 &nbsp;|&nbsp; <i class="bi bi-envelope me-1"></i> hikaris@gmail.com</span>
    <span>Universidad Nacional — Diseño de Sitios Web — Proyecto 3</span>
  </div>
</div>

<!-- NAVBAR -->
<nav class="navbar-main">
  <div class="navbar-inner">
    <a href="../index.html" class="brand">Hikari's <span>Records</span></a>
    <div class="search-bar">
      <input type="text" placeholder="Buscar artistas, álbumes, géneros...">
      <button><i class="bi bi-search"></i></button>
    </div>
    <ul class="nav-links d-none d-lg-flex">
      <li><a href="../index.html">Inicio</a></li>
      <li><a href="#">Artistas</a></li>
      <li><a href="#">Álbumes</a></li>
      <li><a href="#">Géneros</a></li>
      <li><a href="#" class="active">Cuenta</a></li>
    </ul>
    <div class="d-flex gap-1 ms-auto ms-lg-0">
      <button class="nav-icon-btn"><i class="bi bi-heart"></i></button>
      <button class="nav-icon-btn"><i class="bi bi-bag"></i></button>
      <button class="nav-icon-btn"><i class="bi bi-person"></i></button>
    </div>
  </div>
</nav>

<!-- BREADCRUMB -->
<div class="breadcrumb-bar">
  <div class="container-fluid px-4">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="../index.html"><i class="bi bi-house me-1"></i>Inicio</a></li>
        <li class="breadcrumb-item active">Mi Cuenta</li>
      </ol>
    </nav>
  </div>
</div>

<!-- PAGE LAYOUT -->
<div class="page-layout">

  <!-- SIDEBAR -->
  <aside class="sidebar d-none d-xl-block">

    <div class="sidebar-card">
      <div class="sidebar-title"><i class="bi bi-mortarboard me-2"></i>Proyecto</div>
      <div style="font-size:12px; color:#666; line-height:1.7;">
        <strong style="color:#1a1a1a;">Universidad Nacional</strong><br>
        Escuela de Informática<br>
        Diseño de Sitios Web<br>
        <span style="color:#c9a96e; font-weight:600;">Proyecto 3 — InjaX SSG</span>
      </div>
    </div>

    <div class="sidebar-card">
      <div class="sidebar-title">Categorías</div>
      <a href="#" class="sidebar-link"><i class="bi bi-music-note-beamed"></i> Pop <span class="badge-count">24</span></a>
      <a href="#" class="sidebar-link"><i class="bi bi-music-note-list"></i> Rock <span class="badge-count">18</span></a>
      <a href="#" class="sidebar-link"><i class="bi bi-soundwave"></i> Reggaeton <span class="badge-count">31</span></a>
      <a href="#" class="sidebar-link"><i class="bi bi-vinyl"></i> Jazz <span class="badge-count">12</span></a>
      <a href="#" class="sidebar-link"><i class="bi bi-headphones"></i> Electrónica <span class="badge-count">9</span></a>
      <a href="#" class="sidebar-link"><i class="bi bi-star"></i> K-Pop <span class="badge-count">15</span></a>
    </div>

    <div class="sidebar-card">
      <div class="sidebar-title">Accesos rápidos</div>
      <a href="#" class="sidebar-link"><i class="bi bi-people"></i> Artistas</a>
      <a href="#" class="sidebar-link"><i class="bi bi-disc"></i> Álbumes</a>
      <a href="#" class="sidebar-link"><i class="bi bi-cart"></i> Tienda</a>
      <a href="#" class="sidebar-link"><i class="bi bi-search"></i> Búsqueda</a>
    </div>

  </aside>

  <!-- MAIN -->
  <main class="main-content">

    <div class="auth-card">

      <!-- HEADER -->
      <div class="auth-header">
        <i class="bi bi-disc"></i>
        <h2>{{ auth.titulo }}</h2>
        <p>{{ auth.subtitulo }}</p>
      </div>

      <!-- TABS -->
      <div class="auth-tabs">
        {% for tab in auth.tabs %}
          <button class="auth-tab {% if loop.index == 1 %}active{% endif %}"
                  onclick="switchTab('{{ tab.id }}')">
            <i class="bi {{ tab.icono }} me-1"></i> {{ tab.label }}
          </button>
        {% endfor %}
      </div>

      <div class="auth-body">

        <!-- LOGIN PANEL -->
        <div class="auth-panel active" id="panel-login">
          <form action="/login" method="POST">

            {% for campo in auth.login.campos %}
              <div class="mb-3">
                <label class="form-label">{{ campo.label }}</label>
                <div class="input-group">
                  <span class="input-group-text"><i class="bi {{ campo.icono }}"></i></span>
                  <input type="{{ campo.type }}"
                         name="{{ campo.name }}"
                         class="form-control"
                         placeholder="{{ campo.placeholder }}"
                         {% if loop.index == 1 %}autofocus{% endif %}>
                </div>
              </div>
            {% endfor %}

            <button type="submit" class="btn-auth mt-1">{{ auth.login.boton }}</button>
          </form>
        </div>

        <!-- REGISTER PANEL -->
        <div class="auth-panel" id="panel-register">
          <form action="/register" method="POST">

            {% for campo in auth.register.campos %}
              <div class="mb-2">
                <label class="form-label">
                  {{ campo.label }}
                  {% if campo.opcional %}
                    <span class="text-muted fw-normal" style="font-size:12px;">(optional)</span>
                  {% endif %}
                </label>
                <div class="input-group">
                  <span class="input-group-text"><i class="bi {{ campo.icono }}"></i></span>
                  <input type="{{ campo.type }}"
                         name="{{ campo.name }}"
                         class="form-control"
                         placeholder="{{ campo.placeholder }}">
                </div>
              </div>
            {% endfor %}

            <button type="submit" class="btn-auth mt-2">{{ auth.register.boton }}</button>
          </form>
        </div>

      </div>
    </div>

  </main>
</div>

<!-- MARQUEE -->
<div class="marquee-section">
  <div class="marquee-track">
    {% for i in slider_repeticiones %}
      <span class="marquee-item"><i class="bi bi-music-note"></i> {{ slider_texto }}</span>
      <span class="marquee-dot">·</span>
    {% endfor %}
    {% for i in slider_repeticiones %}
      <span class="marquee-item"><i class="bi bi-music-note"></i> {{ slider_texto }}</span>
      <span class="marquee-dot">·</span>
    {% endfor %}
  </div>
</div>

<!-- FOOTER -->
<footer>
  <div class="container">
    <div class="row g-4">
      <div class="col-md-3">
        <div class="footer-brand">Hikari's <span>Records</span></div>
        <p style="font-size:13px; color:#666; margin-top:8px; padding:0;">Tu destino de música y cultura pop.</p>
        <div class="footer-social mt-3">
          <a href="#"><i class="bi bi-facebook"></i></a>
          <a href="#"><i class="bi bi-instagram"></i></a>
          <a href="#"><i class="bi bi-whatsapp"></i></a>
        </div>
      </div>
      <div class="col-md-3">
        <h6>Métodos de pago</h6>
        {% for p in footer.pagos %}<div>{{ p }}</div>{% endfor %}
      </div>
      <div class="col-md-3">
        <h6>Ubicación</h6>
        {% for u in footer.ubicacion %}<div>{{ u }}</div>{% endfor %}
      </div>
      <div class="col-md-3">
        <h6>Contacto</h6>
        {% for c in footer.contacto %}<div>{{ c }}</div>{% endfor %}
      </div>
    </div>
    <div class="footer-divider"></div>
    <div class="footer-bottom">
      © 2026 Hikari's Records — Universidad Nacional, Escuela de Informática, Diseño de Sitios Web, Proyecto 3
    </div>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  function switchTab(tab) {
    document.querySelectorAll('.auth-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.auth-panel').forEach(p => p.classList.remove('active'));
    document.getElementById('panel-' + tab).classList.add('active');
    event.target.classList.add('active');
  }
</script>

</body>
</html>
